---
import { getImage } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import App from "./App";
import { CookieConsent } from "./CookieConsent";
import { ProjectsSection } from "./ProjectsSection";
import { HERO_DATA } from "../data/hero";
import { projects } from "../data/projects";
import { projectTranslations } from "../data/projects.es";
import type { Locale } from "../i18n";
import type { ProjectInfo } from "../types";

const { locale } = Astro.props as { locale: Locale };
const portrait = await getImage({ src: HERO_DATA.photo, width: 592, format: "webp", quality: 83 });
const optimizedProjects = await Promise.all(projects.map(async ({ cover, ...project }): Promise<ProjectInfo> => {
  const translation = locale === "es" ? projectTranslations[project.id] : undefined;
  const localized = translation ? { ...project, ...translation, title: translation.title ?? project.title } : project;
  if (!cover) return localized;
  const width = Math.min(560, cover.image.width);
  const height = Math.round(cover.image.height * width / cover.image.width);
  const image = await getImage({ src: cover.image, width, height, format: "webp" });
  return { ...localized, cover: { ...cover, alt: translation?.alt ?? cover.alt, image: { src: image.src, width, height } } };
}));
---

<Layout locale={locale}>
  <App locale={locale} portrait={{ src: portrait.src, width: 592, height: 592 }}>
    <ProjectsSection projects={optimizedProjects} locale={locale} client:visible />
  </App>
  <CookieConsent locale={locale} client:load />
</Layout>
