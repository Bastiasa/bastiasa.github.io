---
import { getImage } from "astro:assets";
import { GITHUB_URL, LINKEDIN_URL } from "../data/footer";
import { NAME, ROLE, STACK, SITE_DESCRIPTION } from "../data/globals";
import { HERO_DATA } from "../data/hero";
import { coreBackend } from "../data/skills";
import { CONSENT_STORAGE_KEY } from "../analytics";
import "../index.css";

const analyticsId = "G-JV9ML4JJME";
const canonical = new URL(Astro.url.pathname, Astro.site);
const title = `${NAME} | ${ROLE} | ${STACK}`;
const socialImage = await getImage({ src: HERO_DATA.photo, width: 640, format: "jpeg", quality: 85 });
const socialImageUrl = new URL(socialImage.src, canonical);
const personId = new URL("#luis-bastidas", canonical).href;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  name: title,
  url: canonical.href,
  description: SITE_DESCRIPTION,
  inLanguage: "en",
  mainEntity: {
    "@type": "Person",
    "@id": personId,
    name: NAME,
    jobTitle: ROLE,
    image: socialImageUrl.href,
    url: canonical.href,
    sameAs: [GITHUB_URL, LINKEDIN_URL],
    address: {
      "@type": "PostalAddress",
      addressRegion: "Antioquia",
      addressCountry: "CO",
    },
    knowsLanguage: ["es", "en"],
    knowsAbout: [...coreBackend, "Real-time systems", "Networking", "Automation"],
  },
};
---

<!doctype html>
<html lang="en" data-mantine-color-scheme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content={NAME} />
    <meta name="description" content={SITE_DESCRIPTION} />
    <meta name="google-site-verification" content="w9vSOoe0qFtiMZcLGwShpZovpKKssJqrk1dr6cbyuZM" />
    <title>{title}</title>
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" sizes="any" />

    <meta property="og:type" content="profile" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={SITE_DESCRIPTION} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={socialImageUrl.href} />
    <meta property="og:image:width" content="640" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content={`Portrait of ${NAME}`} />
    <meta property="profile:first_name" content="Luis" />
    <meta property="profile:last_name" content="Bastidas" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={SITE_DESCRIPTION} />
    <meta name="twitter:image" content={socialImageUrl.href} />
    <meta name="twitter:image:alt" content={`Portrait of ${NAME}`} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")} />

    <script define:vars={{ analyticsId, consentStorageKey: CONSENT_STORAGE_KEY }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      window.gtag('consent', 'default', { analytics_storage: 'denied' });

      try {
        if (localStorage.getItem(consentStorageKey) === 'accepted') {
          window.gtag('consent', 'update', { analytics_storage: 'granted' });
        }
      } catch {
        // Keep the default when storage is unavailable.
      }

      window.gtag('js', new Date());
      window.gtag('config', analyticsId);
    </script>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${analyticsId}`}></script>
  </head>
  <body>
    <slot />
  </body>
</html>
