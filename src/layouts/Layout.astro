---
import { getImage } from "astro:assets";
import { GITHUB_URL, LINKEDIN_URL } from "../data/footer";
import { CONTACT_EMAIL, NAME, ROLE, STACK, SITE_DESCRIPTION } from "../data/globals";
import { HERO_DATA } from "../data/hero";
import { coreBackend } from "../data/skills";
import { CONSENT_STORAGE_KEY } from "../analytics";
import { languageRoutes, languageStorageKey, translate, type Locale } from "../i18n";
import "../index.css";

const { locale } = Astro.props as { locale: Locale };
const t = (text: string) => translate(locale, text);
const description = t(SITE_DESCRIPTION);
const englishUrl = new URL(languageRoutes.en, Astro.site);
const spanishUrl = new URL(languageRoutes.es, Astro.site);

const analyticsId = "G-JV9ML4JJME";
const canonical = new URL(Astro.url.pathname, Astro.site);
const title = `${NAME} | ${t(ROLE)} | ${t(STACK)}`;
const socialImage = await getImage({ src: HERO_DATA.photo, width: 640, format: "jpeg", quality: 85 });
const socialImageUrl = new URL(socialImage.src, canonical);
const personId = new URL("#luis-bastidas", englishUrl).href;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  name: title,
  url: canonical.href,
  description,
  inLanguage: locale,
  mainEntity: {
    "@type": "Person",
    "@id": personId,
    name: NAME,
    jobTitle: t(ROLE),
    email: CONTACT_EMAIL || undefined,
    image: socialImageUrl.href,
    url: canonical.href,
    sameAs: [GITHUB_URL, LINKEDIN_URL],
    address: {
      "@type": "PostalAddress",
      addressRegion: "Antioquia",
      addressCountry: "CO",
    },
    knowsLanguage: ["es", "en"],
    knowsAbout: [...coreBackend, "Real-time systems", "Networking", "Automation"].map(t),
  },
};
---

<!doctype html>
<html lang={locale} data-mantine-color-scheme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content={NAME} />
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="w9vSOoe0qFtiMZcLGwShpZovpKKssJqrk1dr6cbyuZM" />
    <title>{title}</title>
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang="en" href={englishUrl.href} />
    <link rel="alternate" hreflang="es" href={spanishUrl.href} />
    <link rel="alternate" hreflang="x-default" href={englishUrl.href} />
    <script define:vars={{ locale, languageStorageKey, spanishPath: languageRoutes.es }}>
      document.addEventListener('click', (event) => {
        const choice = event.target instanceof Element && event.target.closest('[data-language-choice]');
        if (!choice) return;
        try { localStorage.setItem(languageStorageKey, choice.dataset.languageChoice); } catch {}
      });

      if (locale === 'en' && new URLSearchParams(location.search).get('lang') !== 'en') {
        let preferred;
        try { preferred = localStorage.getItem(languageStorageKey); } catch {}
        if (preferred !== 'en' && preferred !== 'es') {
          preferred = (navigator.languages?.length ? navigator.languages : [navigator.language])
            .map((language) => language?.toLowerCase().split('-')[0])
            .find((language) => language === 'en' || language === 'es');
        }
        if (preferred === 'es') {
          location.replace(spanishPath + location.search + location.hash);
        }
      }
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" sizes="any" />

    <meta property="og:type" content="profile" />
    <meta property="og:locale" content={locale === "es" ? "es_CO" : "en_US"} />
    <meta property="og:site_name" content={NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={socialImageUrl.href} />
    <meta property="og:image:width" content="640" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content={t(`Portrait of ${NAME}`)} />
    <meta property="profile:first_name" content="Luis" />
    <meta property="profile:last_name" content="Bastidas" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl.href} />
    <meta name="twitter:image:alt" content={t(`Portrait of ${NAME}`)} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")} />

    <script define:vars={{ analyticsId, consentStorageKey: CONSENT_STORAGE_KEY }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      window.gtag('consent', 'default', { analytics_storage: 'denied' });

      try {
        if (localStorage.getItem(consentStorageKey) === 'accepted') {
          window.gtag('consent', 'update', { analytics_storage: 'granted' });
        }
      } catch {
        // Keep the default when storage is unavailable.
      }

      window.gtag('js', new Date());
      window.gtag('config', analyticsId);
    </script>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${analyticsId}`}></script>
  </head>
  <body>
    <slot />
  </body>
</html>
